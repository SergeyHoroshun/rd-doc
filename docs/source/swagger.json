{
  "openapi": "3.0.1",
  "info": {
    "title": "Crawler.WebApi",
    "version": "1.0"
  },
  "paths": {
    "/api/v1": {
      "post": {
        "tags": [
          "Api"
        ],
        "parameters": [
          {
            "name": "X-Api-Key",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestV1"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestV1"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RequestV1"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseV1"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseV1"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseV1"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "HealthCheck"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "string"
                }
              },
              "text/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EDataToReturn": {
        "enum": [
          "RawHtml",
          "RenderedHtml",
          "Screenshot",
          "ExtractRules",
          "AiText",
          "AiMarkdown",
          "AiExtract",
          "AiExtractRules"
        ],
        "type": "string"
      },
      "EProxyType": {
        "enum": [
          "Datacenter",
          "Residential"
        ],
        "type": "string"
      },
      "EScreenshotType": {
        "enum": [
          "ViewPort",
          "FullPage"
        ],
        "type": "string"
      },
      "ExtractDataOptions": {
        "type": "object",
        "properties": {
          "dataToReturn": {
            "$ref": "#/components/schemas/EDataToReturn"
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExtractDataRule"
            },
            "nullable": true
          },
          "screenshot": {
            "$ref": "#/components/schemas/ScreenshotOptions"
          }
        },
        "additionalProperties": false
      },
      "ExtractDataRule": {
        "type": "object",
        "properties": {
          "selector": {
            "type": "string",
            "nullable": true
          },
          "aiPrompt": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "JsOptions": {
        "type": "object",
        "properties": {
          "waitMs": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "waitForBrowserEvent": {
            "type": "string",
            "nullable": true
          },
          "waitForSelector": {
            "type": "string",
            "nullable": true
          },
          "window": {
            "$ref": "#/components/schemas/WindowSize"
          },
          "jsScenario": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JsScenarioItem"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "JsScenarioItem": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "nullable": true
          },
          "value": {
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProxyOptions": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "$ref": "#/components/schemas/EProxyType"
          }
        },
        "additionalProperties": false
      },
      "RequestOptions": {
        "type": "object",
        "properties": {
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "nullable": true
          },
          "cookies": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RequestV1": {
        "type": "object",
        "properties": {
          "request": {
            "$ref": "#/components/schemas/RequestOptions"
          },
          "proxy": {
            "$ref": "#/components/schemas/ProxyOptions"
          },
          "jsRender": {
            "$ref": "#/components/schemas/JsOptions"
          },
          "extractData": {
            "$ref": "#/components/schemas/ExtractDataOptions"
          }
        },
        "additionalProperties": false
      },
      "ResponseV1": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "format": "int32"
          },
          "rawHtml": {
            "type": "string",
            "nullable": true
          },
          "renderedHtml": {
            "type": "string",
            "nullable": true
          },
          "screenshot": {
            "type": "string",
            "nullable": true
          },
          "extractedText": {
            "type": "string",
            "nullable": true
          },
          "extractedData": {
            "nullable": true
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ScreenshotOptions": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/EScreenshotType"
          },
          "scrollToSelector": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "WindowSize": {
        "type": "object",
        "properties": {
          "width": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "height": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}